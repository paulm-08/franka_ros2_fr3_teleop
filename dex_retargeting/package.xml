<?xml version="1.0"?>
<package format="3">
  <name>dex_retargeting</name>
  <version>0.5.0</version>
  <description>ROS 2 wrapper for dex-retargeting (Python) with extra helpers.</description>

  <maintainer email="maestre.paul.antoine.q8@dc.tohoku.ac.jp">Paul Maestre</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime deps (minimal; you can add more as needed) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- So it shows up in ros2 pkg list -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
